# Copia questo file in ".env" e inserisci i valori.  Il file .env NON va mai in git.

# Chiave API di Gemini (obbligatoria per analisi e grafici): https://aistudio.google.com/apikey
GEMINI_API_KEY=

# (Opzionale) YouTube Data API v3 - basta una API key, niente OAuth.
# Serve come piano B quando il feed RSS non risponde e per risolvere i nomi @canale.
YOUTUBE_API_KEY=

# (Opzionale) Token del bot Telegram, creato con @BotFather.
TELEGRAM_BOT_TOKEN=

# (Opzionale) Proxy per le richieste a YouTube, es. http://utente:password@host:porta
# Serve solo se la VM e' in cloud e YouTube ne blocca l'IP.
YTKB_PROXY=
